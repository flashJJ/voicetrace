    "id": "yue-saying-regret",
    "type": "proverb",
    "title": "执输行头，惨过败家",
    "subtitle": "粤语俗语 · 争先后 · 执输",
    "region": "广州 / 珠三角",
    "dialect": "粤语（广府片）",
    "summary": "落在人后、错失先机，比败家还惨。形容做事要抢在前面，别等机会溜走。",
    "text": "执输行头，惨过败家。",
    "tags": ["俗语", "机会", "先后"],
    "motifs": ["行头", "败家"],
    "glossary": [
      {
        "term": "执输",
        "meaning": "吃亏、落在下风",
        "note": "粤语“执输”指认输、落后。"
      },
      {
        "term": "行头",
        "meaning": "走在最前面",
        "note": "“行头”在这里指位置靠前。"
      }
    ],
