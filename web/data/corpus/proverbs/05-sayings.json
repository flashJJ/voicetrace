      {
        "term": "抵得",
        "meaning": "受得住、值得",
        "note": "粤语“抵”有承受、值得两个意思。"
      },
      {
        "term": "咸鱼",
        "meaning": "腌制的鱼",
        "note": "咸鱼下饭，但吃多了容易口渴。"
      }
    ],
