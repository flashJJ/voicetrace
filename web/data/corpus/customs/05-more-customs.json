  {
    "id": "yue-custom-private-music",
    "type": "custom",
    "title": "私伙局",
    "subtitle": "广府民俗 · 粤曲 · 街坊",
    "region": "广州 / 珠三角",
    "dialect": "粤语（广府片）",
    "summary": "私伙局是粤曲爱好者自发组成的演唱小团体，常在公园、祠堂、街坊会所摆开锣鼓，自弹自唱。",
    "text": "几张折凳，一把高胡，一只椰胡，街坊围成一圈。唱到熟处，台下有人跟着哼。",
    "tags": ["民俗", "粤曲", "街坊", "公园"],
    "motifs": ["高胡", "折凳", "街坊"],
    "glossary": [
      {
        "term": "私伙局",
        "meaning": "业余粤曲演唱组织",
        "note": "“私伙”指自己的家当、班子。"
      },
      {
        "term": "高胡",
        "meaning": "粤曲主奏乐器",
        "note": "音色高亢明亮，是粤乐的代表乐器。"
      }
    ],
