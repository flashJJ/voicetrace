[
  {
    "id": "yue-custom-lion-dance",
    "type": "custom",
    "title": "醒狮",
    "subtitle": "广府民俗 · 南狮 · 采青",
    "region": "广州 / 佛山 / 珠三角",
    "dialect": "粤语（广府片）",
    "summary": "南狮又称醒狮，逢年过节、开业庆典请狮队上门，采青、吐青，取生意兴隆、步步高升的好意头。",
    "text": "锣鼓一响，狮头一摆，青枝高挂门楣。狮子采到青，主人家封一个红包，图个好意头。",
    "tags": ["民俗", "醒狮", "春节", "好意头"],
    "motifs": ["狮头", "锣鼓", "青", "红包"],
    "glossary": [
      {
        "term": "采青",
        "meaning": "狮子摘下悬挂的青枝",
        "note": "青多用生菜、芹菜，取“生财”“勤快”的谐音。"
      },
      {
        "term": "意头",
        "meaning": "兆头、彩头",
        "note": "粤语常说过年要讲意头。"
      }
    ],
    "source": [
