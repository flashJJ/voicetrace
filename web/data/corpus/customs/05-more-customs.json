  {
    "id": "yue-custom-qixi",
    "type": "custom",
    "title": "拜七姐",
    "subtitle": "广府民俗 · 七夕 · 乞巧",
    "region": "广州 / 珠三角",
    "dialect": "粤语（广府片）",
    "summary": "七夕又称七姐诞，旧时姑娘们摆上瓜果、针线、巧品，向七姐乞巧，求手巧、求好姻缘。",
    "text": "七月初六晚，天井摆一张小桌，摆上时令瓜果和亲手做的巧品。姑娘们穿针乞巧，说悄悄话。",
    "tags": ["民俗", "七夕", "乞巧", "姑娘"],
    "motifs": ["七姐", "瓜果", "针线"],
    "glossary": [
      {
        "term": "七姐",
        "meaning": "七夕传说中的仙女",
        "note": "民间把七仙女称作七姐。"
      },
      {
        "term": "乞巧",
        "meaning": "向七姐求一双巧手",
        "note": "穿针引线是乞巧的传统环节。"
      }
    ],
