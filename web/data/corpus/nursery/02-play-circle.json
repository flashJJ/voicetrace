      "细蚊公"
    ],
    "glossary": [
      {
        "term": "荔枝基",
        "meaning": "荔枝园/荔枝树下的地方",
        "note": "珠三角水乡常见荔枝基围。"
      },
      {
        "term": "细蚊公",
        "meaning": "小婴儿、小孩子",
        "note": "粤语昵称，带亲昵意味。"
      }
    ],
