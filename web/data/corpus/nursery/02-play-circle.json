[
  {
    "id": "yue-rhyme-dingding",
    "type": "nursery_rhyme",
    "title": "氹氹转",
    "subtitle": "广府童谣 · 端午 · 龙船",
    "region": "广州 / 珠三角",
    "dialect": "粤语（广府片）",
    "summary": "氹氹转，菊花园，炒米饼，糯米圆。阿妈带我去睇龙船，我却只想睇鸡仔。",
    "text": "氹氹转，菊花园，\n炒米饼，糯米圆。\n阿妈带我睇龙船。\n我唔睇，睇鸡仔。\n鸡仔大，捉去卖。\n卖得几多钱？\n卖得三百六十五个仙。",
    "tags": [
      "童谣",
      "端午",
      "龙船",
      "童年"
    ],
    "motifs": [
      "氹氹转",
      "菊花园",
      "炒米饼",
      "龙船",
      "鸡仔"
    ],
    "glossary": [
      {
        "term": "氹氹转",
        "meaning": "转圈圈",
        "note": "形容小孩围圈玩耍。"
      },
      {
        "term": "睇龙船",
        "meaning": "看龙舟",
        "note": "端午扒龙船是珠三角重要民俗。"
      }
    ],
    "source": [
