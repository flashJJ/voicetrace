[
  {
    "id": "yue-rhyme-rain",
    "type": "nursery_rhyme",
    "title": "落雨大",
    "subtitle": "广府童谣 · 下雨 · 市井",
    "region": "广州",
    "dialect": "粤语（广府片）",
    "summary": "落雨大水浸街，阿哥担柴上街卖，阿嫂着花鞋。一首有画面、有市井气的童谣。",
    "text": "落雨大，水浸街，\n阿哥担柴上街卖，\n阿嫂出街着花鞋。\n花鞋花袜花腰带，\n珍珠蝴蝶两边排。\n排排都有十二粒，\n粒粒圆亮冇疵瑕。",
    "tags": [
      "童谣",
      "下雨",
      "市井",
      "广州"
    ],
    "motifs": [
      "落雨",
      "水浸街",
      "花鞋",
      "担柴"
    ],
    "glossary": [
      {
        "term": "水浸街",
        "meaning": "街道被水淹",
        "note": "广州雨季常见，旧时小孩会出门玩水。"
      },
      {
        "term": "冇疵瑕",
        "meaning": "没有瑕疵",
        "note": "“冇”是没有。"
      }
    ],
    "source": [
