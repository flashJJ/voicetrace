        "term": "呈寻",
        "meaning": "猜拳时的口令",
        "note": "类似“石头剪刀布”的节奏口令。"
      },
      {
        "term": "执到",
        "meaning": "捡到",
        "note": "“执”是捡、拾。"
      }
