      "仙人",
      "化石"
    ],
    "glossary": [
      {
        "term": "五羊",
        "meaning": "五只仙羊",
        "note": "广州“羊城”之名的来源。"
      },
      {
        "term": "穗",
        "meaning": "谷穗",
        "note": "广州简称“穗”。"
      }
    ],
